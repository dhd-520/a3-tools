<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net452</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>A3ToolsHub</RootNamespace>
    <AssemblyName>A3ToolsHub</AssemblyName>
    <Nullable>disable</Nullable>
    <Version>1.0.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.WebApi.WebHost" Version="5.2.9" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.Infrastructure" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Global.asax">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="Web.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="PrepareIisPublishLayout" AfterTargets="Publish">
    <ItemGroup>
      <IisBinFiles Include="$(PublishDir)*.dll;$(PublishDir)*.pdb" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)bin" />
    <Copy SourceFiles="@(IisBinFiles)" DestinationFolder="$(PublishDir)bin" SkipUnchangedFiles="true" />
    <Delete Files="@(IisBinFiles)" />
  </Target>

</Project>
